# CUDA training image:  docker build -f docker/Dockerfile.gpu -t wakeword-train-gpu .
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 MPLBACKEND=Agg
RUN apt-get update && apt-get install -y --no-install-recommends libsndfile1 ffmpeg \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt requirements-mlops.txt ./
RUN pip install -r requirements.txt -r requirements-mlops.txt
COPY wakeword/ wakeword/
COPY scripts/ scripts/
COPY apps/ apps/
COPY configs/ configs/
CMD ["bash"]
